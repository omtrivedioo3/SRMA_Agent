# SRMA Agent - local secrets. NOT committed (see .gitignore).
#
# NOTE: this token was pasted into a chat session. Revoke and regenerate it at
#       https://huggingface.co/settings/tokens once setup is complete.
HF_TOKEN=

# --------------------------------------------------------------------------
# REQUIRED for Gemini orchestration via Google AI Studio.
# Create one free at https://aistudio.google.com/apikey and paste it below.
# No quotes, no spaces around the '='. It starts with "AIza".
# Leave blank and the agent still runs, but orchestration falls back to the
# local MedGemma model, which is much weaker at deciding which tool to call.
# --------------------------------------------------------------------------
GOOGLE_API_KEY=

# Optional: raises PubMed rate limit from 3 to 10 req/sec.
# Get one free at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Optional but polite. OpenAlex, Crossref and Unpaywall give faster, more
# reliable service to callers who identify themselves.
SRMA_CONTACT_EMAIL=

# --------------------------------------------------------------------------
# Tuning. Screening and extraction are the slow phases: each record needs
# its own model call. Lower these for a quick demo, raise them for a real
# review.
# --------------------------------------------------------------------------
SRMA_MAX_ABSTRACTS_TO_SCREEN=0
SRMA_MAX_RECORDS_PER_SOURCE=200

# --------------------------------------------------------------------------
# Clinical model: MedGemma on Vertex AI (dedicated endpoint). Local Ollama
# MedGemma is kept as the automatic fallback if the endpoint errors.
# Auth: `gcloud auth application-default login` (or a service account).
# --------------------------------------------------------------------------
SRMA_CLINICAL_MODEL=vertex_medgemma
SRMA_LOCAL_CLINICAL_MODEL=ollama_chat/medgemma
SRMA_VERTEX_FALLBACK_TO_LOCAL=1
SRMA_VERTEX_PROJECT_ID=332110629135
SRMA_VERTEX_PROJECT_NUMBER=781612439219
SRMA_VERTEX_LOCATION=asia-southeast1
SRMA_VERTEX_MEDGEMMA_ENDPOINT_ID=mg-endpoint-b81452c7-c8ea-4102-8139-5b3a53d09106
SRMA_VERTEX_TIMEOUT=180

# Parallel records in flight for screening / extraction (hosted endpoint).
SRMA_CLINICAL_MAX_WORKERS=8

# Extraction cap: 0 = extract every included study.
SRMA_MAX_STUDIES_TO_EXTRACT=0
