# SRMA Agent - Environment Configuration Template
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Hugging Face token (optional, used by scripts/download_medgemma.py)
HF_TOKEN=

# REQUIRED for Gemini orchestration via Google AI Studio
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: raises PubMed rate limit from 3 to 10 req/sec
NCBI_API_KEY=

# Optional: polite contact email for OpenAlex / Crossref / Unpaywall
SRMA_CONTACT_EMAIL=

# Default screening and per-source caps (CPU-friendly defaults)
SRMA_MAX_ABSTRACTS_TO_SCREEN=20
SRMA_MAX_RECORDS_PER_SOURCE=25
