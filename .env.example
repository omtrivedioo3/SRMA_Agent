# SRMA Agent - Environment Configuration Template
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Hugging Face token (optional, only for scripts/download_medgemma.py)
HF_TOKEN=

# REQUIRED for Gemini orchestration via Google AI Studio
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: raises PubMed rate limit from 3 to 10 req/sec
NCBI_API_KEY=

# Optional: polite contact email for OpenAlex / Crossref / Unpaywall
SRMA_CONTACT_EMAIL=

# --------------------------------------------------------------------------
# Clinical model (MedGemma)
# --------------------------------------------------------------------------
# vertex_medgemma      -> MedGemma deployed on a Vertex AI dedicated endpoint
#                         (production). Auth via Application Default
#                         Credentials: `gcloud auth application-default login`
#                         or a service account on Cloud Run.
# ollama_chat/medgemma -> local MedGemma via Ollama (offline / fallback).
SRMA_CLINICAL_MODEL=vertex_medgemma
SRMA_LOCAL_CLINICAL_MODEL=ollama_chat/medgemma

# If the Vertex endpoint fails, retry the same call on local Ollama (1/0).
SRMA_VERTEX_FALLBACK_TO_LOCAL=1

# Vertex dedicated endpoint coordinates. The URL is assembled as
#   https://<ENDPOINT_ID>.<LOCATION>-<PROJECT_NUMBER>.prediction.vertexai.goog
#     /v1/projects/<PROJECT_ID>/locations/<LOCATION>/endpoints/<ENDPOINT_ID>:predict
# or set SRMA_VERTEX_MEDGEMMA_URL to override the whole thing.
SRMA_VERTEX_PROJECT_ID=332110629135
SRMA_VERTEX_PROJECT_NUMBER=781612439219
SRMA_VERTEX_LOCATION=asia-southeast1
SRMA_VERTEX_MEDGEMMA_ENDPOINT_ID=mg-endpoint-b81452c7-c8ea-4102-8139-5b3a53d09106
SRMA_VERTEX_TIMEOUT=180

# Parallel records in flight during screening / extraction.
# 8 is a good default for a hosted endpoint; use 2 for local CPU Ollama.
SRMA_CLINICAL_MAX_WORKERS=8

# --------------------------------------------------------------------------
# Processing caps  (0 = unbounded)
# --------------------------------------------------------------------------
# With MedGemma on Vertex there is no need for a ceiling: every deduplicated
# record is screened and every included study is extracted, as PRISMA
# requires. Set positive numbers only for a quick local smoke test.
SRMA_MAX_RECORDS_PER_SOURCE=200
SRMA_MAX_ABSTRACTS_TO_SCREEN=0
SRMA_MAX_STUDIES_TO_EXTRACT=0
